DB_SA_PASSWORD=cambiar_por_una_contrasena_segura
DB_NAME=granja_el_chiflon
DATABASE_URL=sqlserver://localhost:1433;database=granja_el_chiflon;user=sa;password=cambiar_por_una_contrasena_segura;encrypt=true;trustServerCertificate=true
PORT=3000
NODE_ENV=development
SESSION_DURATION_HOURS=8
AZURE_BLOB_CONTAINER_ANIMALES=animales
# Backend ejecutado en el host con Azurite:
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Produccion (usar esta URL en lugar de AZURE_STORAGE_CONNECTION_STRING):
# AZURE_STORAGE_ACCOUNT_URL=https://cuenta.blob.core.windows.net
# Solo para identidad administrada asignada por usuario:
# AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=

# Proporcionar solo al ejecutar npm run usuarios:bootstrap.
BOOTSTRAP_WEBMASTER_NOMBRE_COMPLETO=
BOOTSTRAP_WEBMASTER_USUARIO=
BOOTSTRAP_WEBMASTER_CORREO=
BOOTSTRAP_WEBMASTER_CONTRASENA=
