  usuario                 UsuarioCuenta           @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  inventarioTransacciones InventarioTransaccion[]

  @@index([animalId])
  @@index([loteProduccionId])
  @@index([productoId])
  @@index([usuarioId])
  @@index([tipoAplicacion])
  @@index([fechaAplicacion])
  @@map("sanidad_aplicaciones")
