generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ======================================================
// MÓDULO: USUARIOS
// ======================================================

model UsuarioRol {
  rolId              Int      @id @default(autoincrement()) @map("rol_id")
  nombre             String   @unique @db.NVarChar(100)
  descripcion        String?  @db.NVarChar(500)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  usuarios      UsuarioCuenta[]
  rolesPermisos UsuarioRolPermiso[]

  @@map("usuarios_roles")
}

model UsuarioPermiso {
  permisoId     Int      @id @default(autoincrement()) @map("permiso_id")
  codigo        String   @unique @db.NVarChar(100)
  nombre        String   @db.NVarChar(150)
  modulo        String   @db.NVarChar(100)
  accion        String   @db.NVarChar(100)
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2

  rolesPermisos UsuarioRolPermiso[]

  @@map("usuarios_permisos")
}

model UsuarioCuenta {
  usuarioId          Int      @id @default(autoincrement()) @map("usuario_id")
  rolId              Int      @map("rol_id")
  nombreCompleto     String   @map("nombre_completo") @db.NVarChar(200)
  nombreUsuario      String   @unique @map("nombre_usuario") @db.NVarChar(100)
  correo             String   @unique @db.NVarChar(200)
  contrasenaHash     String   @map("contrasena_hash") @db.NVarChar(255)
  estado             String   @default("ACTIVO") @db.NVarChar(20)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  rol UsuarioRol @relation(fields: [rolId], references: [rolId], onDelete: NoAction, onUpdate: NoAction)

  sesiones                 UsuarioSesion[]
  bitacoras                UsuarioBitacora[]
  ventas                   VentaRegistro[]
  inventarioTransacciones  InventarioTransaccion[]
  inventarioTransferencias InventarioTransferencia[]
  produccionTransacciones  ProduccionTransaccion[]
  produccionEventos        ProduccionEvento[]
  produccionOperaciones    ProduccionOperacion[]

  permisosAsignados          UsuarioRolPermiso[]         @relation("UsuarioAsignadorRolPermiso")
  asignacionesProduccion     ProduccionAsignacionLote[]
  historialEstadosProduccion ProduccionHistorialEstado[]
  medicionesProduccion       ProduccionMedicion[]
  alimentacionAsignaciones   AlimentacionAsignacion[]
  alimentacionRegistros      AlimentacionRegistro[]
  sanidadAplicaciones        SanidadAplicacion[]

  @@index([rolId])
  @@map("usuarios_cuentas")
}

model UsuarioRolPermiso {
  rolPermisoId       Int      @id @default(autoincrement()) @map("rol_permiso_id")
  rolId              Int      @map("rol_id")
  permisoId          Int      @map("permiso_id")
  usuarioAsignadorId Int      @map("usuario_asignador_id")
  fechaAsignacion    DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_asignacion") @db.DateTime2

  rol UsuarioRol @relation(fields: [rolId], references: [rolId], onDelete: NoAction, onUpdate: NoAction)

  permiso UsuarioPermiso @relation(fields: [permisoId], references: [permisoId], onDelete: NoAction, onUpdate: NoAction)

  usuarioAsignador UsuarioCuenta @relation("UsuarioAsignadorRolPermiso", fields: [usuarioAsignadorId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([rolId, permisoId])
  @@index([rolId])
  @@index([permisoId])
  @@index([usuarioAsignadorId])
  @@map("usuarios_roles_permisos")
}

model UsuarioSesion {
  sesionId        Int       @id @default(autoincrement()) @map("sesion_id")
  usuarioId       Int       @map("usuario_id")
  token           String    @unique @db.NVarChar(500)
  fechaInicio     DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_inicio") @db.DateTime2
  fechaExpiracion DateTime  @map("fecha_expiracion") @db.DateTime2
  fechaCierre     DateTime? @map("fecha_cierre") @db.DateTime2
  estado          String    @default("ACTIVA") @db.NVarChar(20)
  direccionIp     String?   @map("direccion_ip") @db.NVarChar(45)

  usuario UsuarioCuenta @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuarioId])
  @@index([estado])
  @@map("usuarios_sesiones")
}

model UsuarioBitacora {
  bitacoraId  Int      @id @default(autoincrement()) @map("bitacora_id")
  usuarioId   Int?     @map("usuario_id")
  modulo      String   @db.NVarChar(100)
  accion      String   @db.NVarChar(100)
  descripcion String   @db.NVarChar(1000)
  resultado   String   @db.NVarChar(50)
  fecha       DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @db.DateTime2
  direccionIp String?  @map("direccion_ip") @db.NVarChar(45)

  usuario UsuarioCuenta? @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuarioId])
  @@index([modulo])
  @@index([fecha])
  @@map("usuarios_bitacora")
}

// ======================================================
// MÓDULO: CLIENTES Y PROVEEDORES
// ======================================================

model ClienteTipo {
  tipoClienteId      Int      @id @default(autoincrement()) @map("tipo_cliente_id")
  codigo             String   @unique @db.NVarChar(50)
  nombre             String   @db.NVarChar(150)
  descripcion        String?  @db.NVarChar(500)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  clientes ClienteRegistro[]

  @@index([activo])
  @@map("clientes_tipos")
}

model ClienteRegistro {
  clienteId          Int      @id @default(autoincrement()) @map("cliente_id")
  tipoClienteId      Int      @map("tipo_cliente_id")
  codigo             String   @unique @default(dbgenerated("(N'CLI'+right(N'000000'+CONVERT([nvarchar](6),NEXT VALUE FOR [dbo].[clientes_codigo_seq]),(6)))")) @db.NVarChar(9)
  nombreCompleto     String   @map("nombre_completo") @db.NVarChar(200)
  numeroDocumento    String?  @map("numero_documento") @db.NVarChar(50)
  nit                String?  @db.NVarChar(20)
  telefono           String?  @db.NVarChar(30)
  correo             String?  @db.NVarChar(200)
  direccion          String?  @db.NVarChar(500)
  observaciones      String?  @db.NVarChar(1000)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  tipo   ClienteTipo     @relation(fields: [tipoClienteId], references: [tipoClienteId], onDelete: NoAction, onUpdate: NoAction)
  ventas VentaRegistro[]

  @@index([tipoClienteId])
  @@index([nombreCompleto])
  @@index([nit])
  @@index([activo])
  @@map("clientes_registros")
}

model ProveedorTipo {
  tipoProveedorId    Int      @id @default(autoincrement()) @map("tipo_proveedor_id")
  codigo             String   @unique @db.NVarChar(50)
  nombre             String   @db.NVarChar(150)
  descripcion        String?  @db.NVarChar(500)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  proveedores ProveedorRegistro[]

  @@index([activo])
  @@map("proveedores_tipos")
}

model ProveedorRegistro {
  proveedorId        Int      @id @default(autoincrement()) @map("proveedor_id")
  tipoProveedorId    Int      @map("tipo_proveedor_id")
  codigo             String   @unique @default(dbgenerated("(N'PRO'+right(N'000000'+CONVERT([nvarchar](6),NEXT VALUE FOR [dbo].[proveedores_codigo_seq]),(6)))")) @db.NVarChar(9)
  nombre             String   @db.NVarChar(200)
  nombreComercial    String?  @map("nombre_comercial") @db.NVarChar(200)
  numeroDocumento    String?  @map("numero_documento") @db.NVarChar(50)
  nit                String?  @db.NVarChar(20)
  telefono           String?  @db.NVarChar(30)
  correo             String?  @db.NVarChar(200)
  direccion          String?  @db.NVarChar(500)
  observaciones      String?  @db.NVarChar(1000)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  tipo                    ProveedorTipo           @relation(fields: [tipoProveedorId], references: [tipoProveedorId], onDelete: NoAction, onUpdate: NoAction)
  productos               ProveedorProducto[]
  lotesInventario         InventarioLote[]
  inventarioTransacciones InventarioTransaccion[]
  produccionOperaciones   ProduccionOperacion[]

  @@index([tipoProveedorId])
  @@index([nombre])
  @@index([nit])
  @@index([activo])
  @@map("proveedores_registros")
}

// ======================================================
// MÓDULO: INVENTARIO
// ======================================================

model InventarioCategoria {
  categoriaId        Int      @id @default(autoincrement()) @map("categoria_id")
  nombre             String   @unique @db.NVarChar(150)
  descripcion        String?  @db.NVarChar(500)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  productos InventarioProducto[]

  @@index([activo])
  @@map("inventario_categorias")
}

model InventarioProducto {
  productoId         Int      @id @default(autoincrement()) @map("producto_id")
  categoriaId        Int      @map("categoria_id")
  codigo             String   @unique @db.NVarChar(50)
  nombre             String   @db.NVarChar(200)
  descripcion        String?  @db.NVarChar(500)
  unidadMedida       String   @map("unidad_medida") @db.NVarChar(50)
  manejaLotes        Boolean  @default(false) @map("maneja_lotes")
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  categoria InventarioCategoria @relation(fields: [categoriaId], references: [categoriaId], onDelete: NoAction, onUpdate: NoAction)

  proveedores          ProveedorProducto[]
  existencias          InventarioExistencia[]
  lotes                InventarioLote[]
  transferencias       InventarioTransferencia[]
  formulaDetalles      AlimentacionFormulaDetalle[]
  alimentacionDetalles AlimentacionDetalle[]
  sanidadAplicaciones  SanidadAplicacion[]

  @@index([categoriaId])
  @@index([nombre])
  @@index([activo])
  @@map("inventario_productos")
}

model InventarioAlmacen {
  inventarioId       Int      @id @default(autoincrement()) @map("inventario_id")
  codigo             String   @unique @db.NVarChar(50)
  nombre             String   @db.NVarChar(150)
  descripcion        String?  @db.NVarChar(500)
  ubicacion          String?  @db.NVarChar(300)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  existencias InventarioExistencia[]

  @@index([activo])
  @@map("inventario_almacenes")
}

model InventarioExistencia {
  inventarioProductoId Int      @id @default(autoincrement()) @map("inventario_producto_id")
  inventarioId         Int      @map("inventario_id")
  productoId           Int      @map("producto_id")
  existenciaActual     Decimal  @default(0) @map("existencia_actual") @db.Decimal(18, 4)
  existenciaMinima     Decimal  @default(0) @map("existencia_minima") @db.Decimal(18, 4)
  activo               Boolean  @default(true)
  fechaCreacion        DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion   DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  almacen  InventarioAlmacen  @relation(fields: [inventarioId], references: [inventarioId], onDelete: NoAction, onUpdate: NoAction)
  producto InventarioProducto @relation(fields: [productoId], references: [productoId], onDelete: NoAction, onUpdate: NoAction)

  lotes                 InventarioExistenciaLote[]
  transacciones         InventarioTransaccion[]
  transferenciasOrigen  InventarioTransferencia[]  @relation("InventarioTransferenciaOrigen")
  transferenciasDestino InventarioTransferencia[]  @relation("InventarioTransferenciaDestino")

  @@unique([inventarioId, productoId])
  @@unique([inventarioProductoId, productoId])
  @@index([inventarioId])
  @@index([productoId])
  @@index([activo])
  @@map("inventario_existencias")
}

model InventarioLote {
  loteInventarioId   Int       @id @default(autoincrement()) @map("lote_inventario_id")
  productoId         Int       @map("producto_id")
  proveedorId        Int?      @map("proveedor_id")
  codigoLote         String    @map("codigo_lote") @db.NVarChar(100)
  fechaIngreso       DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_ingreso") @db.DateTime2
  fechaFabricacion   DateTime? @map("fecha_fabricacion") @db.Date
  fechaVencimiento   DateTime? @map("fecha_vencimiento") @db.Date
  costoUnitario      Decimal?  @map("costo_unitario") @db.Decimal(18, 4)
  activo             Boolean   @default(true)
  observaciones      String?   @db.NVarChar(1000)
  fechaCreacion      DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  producto       InventarioProducto         @relation(fields: [productoId], references: [productoId], onDelete: NoAction, onUpdate: NoAction)
  proveedor      ProveedorRegistro?         @relation(fields: [proveedorId], references: [proveedorId], onDelete: NoAction, onUpdate: NoAction)
  existencias    InventarioExistenciaLote[]
  transferencias InventarioTransferencia[]

  @@unique([productoId, codigoLote])
  @@unique([loteInventarioId, productoId])
  @@index([productoId])
  @@index([proveedorId])
  @@index([codigoLote])
  @@index([fechaVencimiento])
  @@index([activo])
  @@map("inventario_lotes")
}

model InventarioExistenciaLote {
  existenciaLoteId     Int      @id @default(autoincrement()) @map("existencia_lote_id")
  inventarioProductoId Int      @map("inventario_producto_id")
  loteInventarioId     Int      @map("lote_inventario_id")
  productoId           Int      @map("producto_id")
  existenciaActual     Decimal  @default(0) @map("existencia_actual") @db.Decimal(18, 4)
  fechaCreacion        DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion   DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  existencia            InventarioExistencia      @relation(fields: [inventarioProductoId, productoId], references: [inventarioProductoId, productoId], onDelete: NoAction, onUpdate: NoAction)
  lote                  InventarioLote            @relation(fields: [loteInventarioId, productoId], references: [loteInventarioId, productoId], onDelete: NoAction, onUpdate: NoAction)
  transacciones         InventarioTransaccion[]
  transferenciasOrigen  InventarioTransferencia[] @relation("InventarioTransferenciaLoteOrigen")
  transferenciasDestino InventarioTransferencia[] @relation("InventarioTransferenciaLoteDestino")

  @@unique([inventarioProductoId, loteInventarioId])
  @@unique([existenciaLoteId, inventarioProductoId])
  @@unique([existenciaLoteId, inventarioProductoId, productoId])
  @@index([loteInventarioId])
  @@index([productoId])
  @@map("inventario_existencias_lotes")
}

model InventarioTransferencia {
  transferenciaId             Int      @id @default(autoincrement()) @map("transferencia_id")
  productoId                  Int      @map("producto_id")
  inventarioProductoOrigenId  Int      @map("inventario_producto_origen_id")
  inventarioProductoDestinoId Int      @map("inventario_producto_destino_id")
  existenciaLoteOrigenId      Int?     @map("existencia_lote_origen_id")
  existenciaLoteDestinoId     Int?     @map("existencia_lote_destino_id")
  loteInventarioId            Int?     @map("lote_inventario_id")
  usuarioId                   Int      @map("usuario_id")
  cantidad                    Decimal  @db.Decimal(18, 4)
  documentoReferencia         String?  @map("documento_referencia") @db.NVarChar(150)
  motivo                      String?  @db.NVarChar(500)
  observaciones               String?  @db.NVarChar(1000)
  fechaTransferencia          DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_transferencia") @db.DateTime2

  producto      InventarioProducto        @relation(fields: [productoId], references: [productoId], onDelete: NoAction, onUpdate: NoAction)
  origen        InventarioExistencia      @relation("InventarioTransferenciaOrigen", fields: [inventarioProductoOrigenId], references: [inventarioProductoId], onDelete: NoAction, onUpdate: NoAction)
  destino       InventarioExistencia      @relation("InventarioTransferenciaDestino", fields: [inventarioProductoDestinoId], references: [inventarioProductoId], onDelete: NoAction, onUpdate: NoAction)
  loteOrigen    InventarioExistenciaLote? @relation("InventarioTransferenciaLoteOrigen", fields: [existenciaLoteOrigenId], references: [existenciaLoteId], onDelete: NoAction, onUpdate: NoAction)
  loteDestino   InventarioExistenciaLote? @relation("InventarioTransferenciaLoteDestino", fields: [existenciaLoteDestinoId], references: [existenciaLoteId], onDelete: NoAction, onUpdate: NoAction)
  lote          InventarioLote?           @relation(fields: [loteInventarioId], references: [loteInventarioId], onDelete: NoAction, onUpdate: NoAction)
  usuario       UsuarioCuenta             @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  transacciones InventarioTransaccion[]

  @@index([productoId])
  @@index([inventarioProductoOrigenId])
  @@index([inventarioProductoDestinoId])
  @@index([existenciaLoteOrigenId])
  @@index([existenciaLoteDestinoId])
  @@index([loteInventarioId])
  @@index([usuarioId])
  @@index([fechaTransferencia])
  @@map("inventario_transferencias")
}

model ProveedorProducto {
  proveedorProductoId Int      @id @default(autoincrement()) @map("proveedor_producto_id")
  proveedorId         Int      @map("proveedor_id")
  productoId          Int      @map("producto_id")
  precioReferencia    Decimal? @map("precio_referencia") @db.Decimal(18, 4)
  activo              Boolean  @default(true)
  fechaRelacion       DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_relacion") @db.DateTime2
  fechaActualizacion  DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  proveedor ProveedorRegistro @relation(fields: [proveedorId], references: [proveedorId], onDelete: NoAction, onUpdate: NoAction)

  producto InventarioProducto @relation(fields: [productoId], references: [productoId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([proveedorId, productoId])
  @@index([proveedorId])
  @@index([productoId])
  @@index([activo])
  @@map("proveedores_productos")
}

// ======================================================
// MÓDULO: PRODUCCIÓN
// ======================================================

model ProduccionTipoAnimal {
  tipoAnimalId       Int      @id @default(autoincrement()) @map("tipo_animal_id")
  nombre             String   @unique @db.NVarChar(100)
  descripcion        String?  @db.NVarChar(500)
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  razas    ProduccionRaza[]
  animales ProduccionAnimal[]
  lotes    ProduccionLote[]

  @@index([activo])
  @@map("produccion_tipos_animales")
}

model ProduccionRaza {
  razaId             Int      @id @default(autoincrement()) @map("raza_id")
  tipoAnimalId       Int      @map("tipo_animal_id")
