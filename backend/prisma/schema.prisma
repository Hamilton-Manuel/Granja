  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  tipoAnimal ProduccionTipoAnimal @relation(fields: [tipoAnimalId], references: [tipoAnimalId], onDelete: NoAction, onUpdate: NoAction)
