model VentaRegistro {
  ventaId            Int      @id @default(autoincrement()) @map("venta_id")
  clienteId          Int      @map("cliente_id")
  usuarioId          Int      @map("usuario_id")
  fechaVenta         DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_venta") @db.DateTime2
  subtotal           Decimal  @db.Decimal(18, 2)
  descuento          Decimal  @default(0) @db.Decimal(18, 2)
  total              Decimal  @db.Decimal(18, 2)
  formaPago          String   @map("forma_pago") @db.NVarChar(50)
  estado             String   @default("PENDIENTE") @db.NVarChar(20)
  observaciones      String?  @db.NVarChar(1000)
  fechaCreacion      DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  cliente  ClienteRegistro @relation(fields: [clienteId], references: [clienteId], onDelete: NoAction, onUpdate: NoAction)
  usuario  UsuarioCuenta   @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  detalles VentaDetalle[]
  recibo   VentaRecibo?

  @@index([clienteId])
  @@index([usuarioId])
  @@index([fechaVenta])
  @@index([estado])
  @@map("ventas_registros")
}

model VentaDetalle {
  detalleVentaId   Int      @id @default(autoincrement()) @map("detalle_venta_id")
  ventaId          Int      @map("venta_id")
  loteProduccionId Int      @map("lote_produccion_id")
  cantidadAnimales Int      @map("cantidad_animales")
  precioUnitario   Decimal  @map("precio_unitario") @db.Decimal(18, 2)
  subtotal         Decimal  @db.Decimal(18, 2)
  descripcion      String?  @db.NVarChar(500)
  fechaCreacion    DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2

  venta                   VentaRegistro           @relation(fields: [ventaId], references: [ventaId], onDelete: NoAction, onUpdate: NoAction)
  lote                    ProduccionLote          @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
  produccionTransacciones ProduccionTransaccion[]

  @@unique([ventaId, loteProduccionId])
  @@index([ventaId])
  @@index([loteProduccionId])
  @@map("ventas_detalles")
}

model VentaRecibo {
  reciboId      Int      @id @default(autoincrement()) @map("recibo_id")
  ventaId       Int      @unique @map("venta_id")
  numeroRecibo  String   @unique @map("numero_recibo") @db.NVarChar(50)
  fechaEmision  DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_emision") @db.DateTime2
  monto         Decimal  @db.Decimal(18, 2)
  concepto      String   @db.NVarChar(1000)
  estado        String   @default("EMITIDO") @db.NVarChar(20)
  fechaCreacion DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2

  venta VentaRegistro @relation(fields: [ventaId], references: [ventaId], onDelete: NoAction, onUpdate: NoAction)

  @@index([fechaEmision])
  @@index([estado])
  @@map("ventas_recibos")
}

// ======================================================
// MÓDULO: INVENTARIO - TRANSACCIONES
// ======================================================

model InventarioTransaccion {
  transaccionInventarioId Int      @id @default(autoincrement()) @map("transaccion_inventario_id")
  inventarioProductoId    Int      @map("inventario_producto_id")
  existenciaLoteId        Int?     @map("existencia_lote_id")
  transferenciaId         Int?     @map("transferencia_id")
  transaccionRevertidaId  Int?     @unique @map("transaccion_revertida_id")
  usuarioId               Int      @map("usuario_id")
  proveedorId             Int?     @map("proveedor_id")
  loteProduccionId        Int?     @map("lote_produccion_id")
  animalId                Int?     @map("animal_id")
  alimentacionDetalleId   Int?     @map("alimentacion_detalle_id")
  aplicacionSanitariaId   Int?     @map("aplicacion_sanitaria_id")
  tipoTransaccion         String   @map("tipo_transaccion") @db.NVarChar(30)
  subtipoTransaccion      String   @map("subtipo_transaccion") @db.NVarChar(40)
  cantidad                Decimal  @db.Decimal(18, 4)
  costoUnitario           Decimal? @map("costo_unitario") @db.Decimal(18, 4)
  documentoReferencia     String?  @map("documento_referencia") @db.NVarChar(150)
  motivo                  String?  @db.NVarChar(500)
  observaciones           String?  @db.NVarChar(1000)
  fechaTransaccion        DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_transaccion") @db.DateTime2

  existencia           InventarioExistencia      @relation(fields: [inventarioProductoId], references: [inventarioProductoId], onDelete: NoAction, onUpdate: NoAction)
  existenciaLote       InventarioExistenciaLote? @relation(fields: [existenciaLoteId], references: [existenciaLoteId], onDelete: NoAction, onUpdate: NoAction)
  transferencia        InventarioTransferencia?  @relation(fields: [transferenciaId], references: [transferenciaId], onDelete: NoAction, onUpdate: NoAction)
  transaccionRevertida InventarioTransaccion?    @relation("InventarioReversion", fields: [transaccionRevertidaId], references: [transaccionInventarioId], onDelete: NoAction, onUpdate: NoAction)
  reversion            InventarioTransaccion?    @relation("InventarioReversion")
  usuario              UsuarioCuenta             @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  proveedor            ProveedorRegistro?        @relation(fields: [proveedorId], references: [proveedorId], onDelete: NoAction, onUpdate: NoAction)
  loteProduccion       ProduccionLote?           @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
  animal               ProduccionAnimal?         @relation(fields: [animalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)
  alimentacionDetalle  AlimentacionDetalle?      @relation(fields: [alimentacionDetalleId], references: [detalleAlimentacionId], onDelete: NoAction, onUpdate: NoAction)
  aplicacionSanitaria  SanidadAplicacion?        @relation(fields: [aplicacionSanitariaId], references: [aplicacionSanitariaId], onDelete: NoAction, onUpdate: NoAction)

  @@index([inventarioProductoId])
  @@index([existenciaLoteId])
  @@index([transferenciaId])
  @@index([usuarioId])
  @@index([proveedorId])
  @@index([loteProduccionId])
  @@index([animalId])
  @@index([alimentacionDetalleId])
  @@index([aplicacionSanitariaId])
  @@index([tipoTransaccion])
  @@index([subtipoTransaccion])
  @@index([fechaTransaccion])
  @@map("inventario_transacciones")
}

// ======================================================
// MÓDULO: PRODUCCIÓN - TRANSACCIONES
// ======================================================

model ProduccionTransaccion {
  transaccionProduccionId Int      @id @default(autoincrement()) @map("transaccion_produccion_id")
  operacionProduccionId   Int      @map("operacion_produccion_id")
  loteProduccionId        Int      @map("lote_produccion_id")
  usuarioId               Int      @map("usuario_id")
  ventaDetalleId          Int?     @map("venta_detalle_id")
  tipoTransaccion         String   @map("tipo_transaccion") @db.NVarChar(30)
  cantidad                Int
  documentoReferencia     String?  @map("documento_referencia") @db.NVarChar(150)
  motivo                  String?  @db.NVarChar(500)
  observaciones           String?  @db.NVarChar(1000)
  fechaTransaccion        DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_transaccion") @db.DateTime2

  operacion    ProduccionOperacion @relation(fields: [operacionProduccionId], references: [operacionProduccionId], onDelete: NoAction, onUpdate: NoAction)
  lote         ProduccionLote      @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
  usuario      UsuarioCuenta       @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  ventaDetalle VentaDetalle?       @relation(fields: [ventaDetalleId], references: [detalleVentaId], onDelete: NoAction, onUpdate: NoAction)

  @@index([operacionProduccionId])
  @@index([loteProduccionId])
  @@index([usuarioId])
  @@index([ventaDetalleId])
  @@index([tipoTransaccion])
  @@index([fechaTransaccion])
  @@map("produccion_transacciones")
}

// ======================================================
// MÓDULO: PRODUCCIÓN - EVENTOS
// ======================================================

model ProduccionEvento {
  eventoProduccionId    Int      @id @default(autoincrement()) @map("evento_produccion_id")
  loteProduccionId      Int?     @map("lote_produccion_id")
  animalId              Int?     @map("animal_id")
  usuarioId             Int      @map("usuario_id")
  operacionProduccionId Int?     @map("operacion_produccion_id")
  medicionId            Int?     @map("medicion_id")
  historialEstadoId     Int?     @map("historial_estado_id")
  tipoEvento            String   @map("tipo_evento") @db.NVarChar(50)
  fechaEvento           DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_evento") @db.DateTime2
  descripcion           String   @db.NVarChar(1000)

  lote            ProduccionLote?            @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
  animal          ProduccionAnimal?          @relation(fields: [animalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)
  usuario         UsuarioCuenta              @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  operacion       ProduccionOperacion?       @relation(fields: [operacionProduccionId], references: [operacionProduccionId], onDelete: NoAction, onUpdate: NoAction)
  medicion        ProduccionMedicion?        @relation(fields: [medicionId], references: [medicionId], onDelete: NoAction, onUpdate: NoAction)
  historialEstado ProduccionHistorialEstado? @relation(fields: [historialEstadoId], references: [historialEstadoId], onDelete: NoAction, onUpdate: NoAction)

  @@index([loteProduccionId])
  @@index([animalId])
  @@index([usuarioId])
  @@index([operacionProduccionId])
  @@index([medicionId])
  @@index([historialEstadoId])
  @@index([tipoEvento])
  @@index([fechaEvento])
  @@map("produccion_eventos")
}
