model SanidadAplicacion {
  aplicacionSanitariaId  Int       @id @default(autoincrement()) @map("aplicacion_sanitaria_id")
  animalId               Int?      @map("animal_id")
  loteProduccionId       Int?      @map("lote_produccion_id")
  productoId             Int       @map("producto_id")
  usuarioId              Int       @map("usuario_id")
  tipoAplicacion         String    @map("tipo_aplicacion") @db.NVarChar(50)
  dosis                  Decimal   @db.Decimal(18, 4)
  unidadMedida           String    @map("unidad_medida") @db.NVarChar(30)
  cantidadTotalUtilizada Decimal   @map("cantidad_total_utilizada") @db.Decimal(18, 4)
  fechaAplicacion        DateTime  @map("fecha_aplicacion") @db.Date
  proximaAplicacion      DateTime? @map("proxima_aplicacion") @db.Date
  observaciones          String?   @db.NVarChar(1000)
  fechaRegistro          DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_registro") @db.DateTime2

  animal                  ProduccionAnimal?       @relation(fields: [animalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)
  lote                    ProduccionLote?         @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
