model ProduccionAnimal {
  animalId           Int       @id @default(autoincrement()) @map("animal_id")
  tipoAnimalId       Int       @map("tipo_animal_id")
  razaId             Int?      @map("raza_id")
  madreAnimalId      Int?      @map("madre_animal_id")
  identificacion     String    @unique @db.NVarChar(100)
  sexo               String    @db.NVarChar(20)
  fechaNacimiento    DateTime? @map("fecha_nacimiento") @db.Date
  fechaIngreso       DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_ingreso") @db.DateTime2
  estadoActual       String    @default("ACTIVO") @map("estado_actual") @db.NVarChar(20)
  observaciones      String?   @db.NVarChar(1000)
  fechaCreacion      DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_creacion") @db.DateTime2
  fechaActualizacion DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_actualizacion") @db.DateTime2

  tipoAnimal               ProduccionTipoAnimal        @relation(fields: [tipoAnimalId], references: [tipoAnimalId], onDelete: NoAction, onUpdate: NoAction)
  raza                     ProduccionRaza?             @relation(fields: [razaId, tipoAnimalId], references: [razaId, tipoAnimalId], onDelete: NoAction, onUpdate: NoAction)
  madre                    ProduccionAnimal?           @relation("ProduccionGenealogiaMaterna", fields: [madreAnimalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)
  crias                    ProduccionAnimal[]          @relation("ProduccionGenealogiaMaterna")
  asignaciones             ProduccionAsignacionLote[]
  historialEstados         ProduccionHistorialEstado[]
  mediciones               ProduccionMedicion[]
  alimentacionAsignaciones AlimentacionAsignacion[]
  alimentacionRegistros    AlimentacionRegistro[]
  sanidadAplicaciones      SanidadAplicacion[]
  inventarioTransacciones  InventarioTransaccion[]
  produccionEventos        ProduccionEvento[]
  operaciones              ProduccionOperacionAnimal[]

  @@unique([animalId, tipoAnimalId])
  @@index([tipoAnimalId])
  @@index([razaId])
  @@index([madreAnimalId])
  @@index([estadoActual])
  @@map("produccion_animales")
}

model ProduccionAsignacionLote {
  asignacionLoteId Int       @id @default(autoincrement()) @map("asignacion_lote_id")
  animalId         Int       @map("animal_id")
  loteProduccionId Int       @map("lote_produccion_id")
  tipoAnimalId     Int       @map("tipo_animal_id")
  usuarioId        Int       @map("usuario_id")
  fechaInicio      DateTime  @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_inicio") @db.DateTime2
  fechaFin         DateTime? @map("fecha_fin") @db.DateTime2
  motivoCambio     String?   @map("motivo_cambio") @db.NVarChar(500)
  estado           String    @default("VIGENTE") @db.NVarChar(20)

  animal  ProduccionAnimal @relation(fields: [animalId, tipoAnimalId], references: [animalId, tipoAnimalId], onDelete: NoAction, onUpdate: NoAction)
  lote    ProduccionLote   @relation(fields: [loteProduccionId, tipoAnimalId], references: [loteProduccionId, tipoAnimalId], onDelete: NoAction, onUpdate: NoAction)
  usuario UsuarioCuenta    @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)

  @@index([animalId])
  @@index([loteProduccionId])
  @@index([usuarioId])
  @@index([tipoAnimalId])
  @@index([estado])
  @@map("produccion_asignaciones_lotes")
}

model ProduccionHistorialEstado {
  historialEstadoId Int      @id @default(autoincrement()) @map("historial_estado_id")
  animalId          Int      @map("animal_id")
  usuarioId         Int      @map("usuario_id")
  estadoAnterior    String?  @map("estado_anterior") @db.NVarChar(30)
  estadoNuevo       String   @map("estado_nuevo") @db.NVarChar(30)
  motivo            String?  @db.NVarChar(500)
  fechaCambio       DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_cambio") @db.DateTime2

  animal  ProduccionAnimal   @relation(fields: [animalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)
  usuario UsuarioCuenta      @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  eventos ProduccionEvento[]

  @@index([animalId])
  @@index([usuarioId])
  @@index([fechaCambio])
  @@map("produccion_historial_estados")
}

model ProduccionMedicion {
  medicionId       Int      @id @default(autoincrement()) @map("medicion_id")
  animalId         Int?     @map("animal_id")
  loteProduccionId Int?     @map("lote_produccion_id")
  usuarioId        Int      @map("usuario_id")
  tipoMedicion     String   @map("tipo_medicion") @db.NVarChar(50)
  valor            Decimal  @db.Decimal(18, 4)
  unidadMedida     String   @map("unidad_medida") @db.NVarChar(30)
  fechaMedicion    DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_medicion") @db.DateTime2
  observaciones    String?  @db.NVarChar(1000)

  animal  ProduccionAnimal?  @relation(fields: [animalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)
  lote    ProduccionLote?    @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
  usuario UsuarioCuenta      @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  eventos ProduccionEvento[]

  @@index([animalId])
  @@index([loteProduccionId])
  @@index([usuarioId])
  @@index([fechaMedicion])
  @@map("produccion_mediciones")
}

model ProduccionOperacion {
  operacionProduccionId Int      @id @default(autoincrement()) @map("operacion_produccion_id")
  usuarioId             Int      @map("usuario_id")
  proveedorId           Int?     @map("proveedor_id")
  loteProduccionId      Int?     @map("lote_produccion_id")
  operacionRevertidaId  Int?     @unique @map("operacion_revertida_id")
  tipoOperacion         String   @map("tipo_operacion") @db.NVarChar(30)
  subtipoOperacion      String   @map("subtipo_operacion") @db.NVarChar(40)
  documentoReferencia   String?  @map("documento_referencia") @db.NVarChar(150)
  motivo                String?  @db.NVarChar(500)
  observaciones         String?  @db.NVarChar(1000)
  fechaOperacion        DateTime @default(dbgenerated("CONVERT(datetime2(7), (SYSUTCDATETIME() AT TIME ZONE 'UTC') AT TIME ZONE 'Central America Standard Time')")) @map("fecha_operacion") @db.DateTime2

  usuario            UsuarioCuenta               @relation(fields: [usuarioId], references: [usuarioId], onDelete: NoAction, onUpdate: NoAction)
  proveedor          ProveedorRegistro?          @relation(fields: [proveedorId], references: [proveedorId], onDelete: NoAction, onUpdate: NoAction)
  lote               ProduccionLote?             @relation(fields: [loteProduccionId], references: [loteProduccionId], onDelete: NoAction, onUpdate: NoAction)
  operacionRevertida ProduccionOperacion?        @relation("ProduccionReversion", fields: [operacionRevertidaId], references: [operacionProduccionId], onDelete: NoAction, onUpdate: NoAction)
  reversion          ProduccionOperacion?        @relation("ProduccionReversion")
  animales           ProduccionOperacionAnimal[]
  transacciones      ProduccionTransaccion[]
  eventos            ProduccionEvento[]

  @@index([usuarioId])
  @@index([proveedorId])
  @@index([loteProduccionId])
  @@index([tipoOperacion])
  @@index([subtipoOperacion])
  @@index([fechaOperacion])
  @@map("produccion_operaciones")
}

model ProduccionOperacionAnimal {
  operacionAnimalId     Int      @id @default(autoincrement()) @map("operacion_animal_id")
  operacionProduccionId Int      @map("operacion_produccion_id")
  animalId              Int      @map("animal_id")
  costoAdquisicion      Decimal? @map("costo_adquisicion") @db.Decimal(18, 2)

  operacion ProduccionOperacion @relation(fields: [operacionProduccionId], references: [operacionProduccionId], onDelete: NoAction, onUpdate: NoAction)
  animal    ProduccionAnimal    @relation(fields: [animalId], references: [animalId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([operacionProduccionId, animalId])
  @@index([animalId])
  @@map("produccion_operaciones_animales")
}

